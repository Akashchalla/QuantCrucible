# Copy to .env (git-ignored). Everything is optional: with no keys at all the research
# pipeline (run_all.py) still reproduces the note from public data.

# --- live / paper layer ---------------------------------------------------------
# Massive (formerly Polygon.io): official daily opens/closes + real-time snapshots. Required for `python -m live`.
MASSIVE_API_KEY=
# Databento: Nasdaq opening-imbalance (NOII) indicative prices before the 09:28 MOO cut-off. Optional.
DATABENTO_API_KEY=
# Timescale / Postgres for signals, orders, fills, P&L, risk events. Optional: falls back to live/state/live.sqlite.
DATABASE_URL=
# Gemini: optional plain-English briefing from the dashboard numbers (`python -m live briefing`).
GEMINI_API_KEY=AQ.Ab8RN6I8ZSjGX7dEVt6SAh_YRWjfFKE-FHzvDcPvBlKkBE4GeQ
GEMINI_MODEL=gemini-3.8-flash
# Alpaca: if both are set, orders go to Alpaca (paper endpoint by default) instead of the simulated broker.
ALPACA_API_KEY=
ALPACA_API_SECRET=
ALPACA_BASE_URL=https://paper-api.alpaca.markets

# --- sizing and risk limits (defaults shown) --------------------------------------
LIVE_NOTIONAL_PER_SIDE=1000000
LIVE_MAX_NAME_PCT=0.025
LIVE_DAILY_LOSS_LIMIT_PCT=0.05
LIVE_REVIEW_DRAWDOWN_PCT=0.03
LIVE_STALE_VIX_DAYS=4
LIVE_MAX_INDICATIVE_AGE_S=180
LIVE_DATABENTO_COST_CAP=0.25
# 8-K study: Databento is only the fallback when Massive has no bar for that contract.
# Per call the code refuses anything above $2. This stops the whole fallback past $40.
DATABENTO_STUDY_BUDGET=40
# Optional. If empty, run_eightk.py writes the briefing text and does not call ElevenLabs.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=EXAVITQu4vr4xnSDxMaL
# Second voice used by the two-speaker Risk Committee audio.
ELEVENLABS_RISK_VOICE_ID=JBFqnCBsd6RMkjVDRZzb
# Voice War Room: Scribe STT + low-latency TTS + expressive two-speaker dialogue.
ELEVENLABS_STT_MODEL=scribe_v2
ELEVENLABS_TTS_MODEL=eleven_flash_v2_5
ELEVENLABS_DIALOGUE_MODEL=eleven_v4

# --- Quant Crucible -------------------------------------------------------------
# Same model powers chat routing, Google-grounded company research, and screenshot vision.
# Google Search grounding is enabled only for questions that need current public information.
GEMINI_LIVE_MODEL=gemini-3.8-live
# Numerical verification is local/deterministic; Gemini explains and critiques the results.
# Realtime Scribe model (the portable Streamlit UI uses server-side push-to-talk by default).
ELEVENLABS_STT_REALTIME_MODEL=scribe_v2_realtime
# Optional true full-duplex ElevenLabs Speech Engine mode. See QUANT_CRUCIBLE.md.
ELEVENLABS_SPEECH_ENGINE_ID=
ELEVENLABS_SPEECH_ENGINE_PORT=3001
# Browser voice API CORS. Add your deployed frontend origin when not running localhost.
CRUCIBLE_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
